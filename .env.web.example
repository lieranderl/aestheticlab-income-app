# Copy to .env.web (gitignored) for `make web` / `make web-dev`. Not needed for
# `make dev` (emulator) or `make dev-memory`, which set their own data settings.

# Where the app is reached; https turns on HSTS and Secure cookies.
INCOME_BASE_URL=http://localhost:8080
# PORT=8080

# Firestore. Unset = in-memory store (data lost on restart).
# INCOME_FIRESTORE_PROJECT=<project>
# INCOME_FIRESTORE_DATABASE=aestheticlab-income
# Local emulator (make firestore):
# FIRESTORE_EMULATOR_HOST=localhost:8086

# Signs session cookies; 32+ random bytes (openssl rand -base64 48). Required
# with real Firestore; the memory store and the emulator use a random key per run.
# INCOME_SESSION_KEY=
# Without INCOME_FIRESTORE_PROJECT the app runs on memory and logs a one-off
# login for "anna" (must be changed at first sign-in).

# Salon timezone for "today".
# INCOME_TZ=Europe/Brussels
# First month the app keeps: 2026-11 in production (default), 2026-10 on the trial.
# INCOME_START_MONTH=2026-11
