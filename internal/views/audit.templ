package views

import "strconv"

type AuditCard struct {
	Entity, Subject, Actor, Action, At, Href string
	HrefLabel                                string // what Href opens: «Открыть отчёт», «Открыть категорию»…
	Changes                                  []MoneyRow
}
type AuditHistory struct {
	Filters HistoryFilters
	Paging  Paging
	Rows    []AuditCard
}

// auditFoldAfter is how many changes show before the list folds.
const auditFoldAfter = 3

templ auditChanges(rows []MoneyRow) {
	<dl class="flex flex-col gap-2">
		for _, change := range rows {
			<div><dt class="text-sm text-base-content/60">{ change.Name }</dt><dd class="break-words font-medium">{ change.Value }</dd></div>
		}
	</dl>
}

templ AuditPage(nav Nav, p AuditHistory) {
	@Layout("Журнал изменений", nav) {
		@PageHeader("Журнал изменений", "/more")
		<div class="flex flex-col gap-4">
			@historyFilters(p.Filters)
			if len(p.Rows) == 0 {
				<p class="rounded-box bg-base-100 p-4 text-base-content/60">По этим фильтрам изменений нет.</p>
			}
			for _, row := range p.Rows {
				<article class="card bg-base-100 shadow-sm">
					<div class="card-body gap-3 p-4">
						<h2 class="font-semibold break-words">{ row.Entity } · { row.Action }</h2>
						if row.Subject != "" {
							<p class="break-words">{ row.Subject }</p>
						}
						<p class="text-sm text-base-content/70 break-words">{ row.Actor } · { row.At }</p>
						if len(row.Changes) > 0 && len(row.Changes) <= auditFoldAfter {
							@auditChanges(row.Changes)
						} else if len(row.Changes) > auditFoldAfter {
							// Long change lists fold so the log stays scannable.
							<details class="collapse collapse-arrow -mx-2 w-auto bg-base-200">
								<summary class="collapse-title min-h-11 px-2 py-3 pe-10 text-sm font-medium">Изменения: { strconv.Itoa(len(row.Changes)) }</summary>
								<div class="collapse-content px-2">
									@auditChanges(row.Changes)
								</div>
							</details>
						}
						if row.Href != "" {
							<a class="btn min-h-11" href={ templ.SafeURL(row.Href) }>{ row.HrefLabel }</a>
						}
					</div>
				</article>
			}
			@paging(p.Paging)
		</div>
	}
}
