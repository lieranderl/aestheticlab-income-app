package views

// Icon renders a Lucide icon as inline SVG on the server, so icons survive
// Datastar morphs and no icon runtime ships to the phone. After using a new
// icon name in a template, run `bun run icons` to regenerate icons_gen.go.
templ Icon(name string, class string) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		class={ "lucide shrink-0", class }
		aria-hidden="true"
		focusable="false"
	>
		@templ.Raw(iconPath(name))
	</svg>
}
