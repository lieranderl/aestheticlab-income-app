package views

// LoginForm is the login form's state.
type LoginForm struct {
	Username string
	Error    string
	// ClearDrafts is set right after a logout: draft.js forgets the
	// unsaved drafts on this phone.
	ClearDrafts bool
}

// LoginPage is the phone-first sign-in screen; it works without JS.
templ LoginPage(f LoginForm) {
	@Layout("Вход", Nav{}) {
		<div class="mx-auto flex min-h-dvh max-w-sm flex-col justify-center gap-6 py-10">
			<div class="flex flex-col items-center gap-3 text-center">
				<img src="/static/icons/favicon.svg" width="64" height="64" alt="" class="size-16 rounded-box"/>
				<div>
					<h1 class="text-2xl font-semibold">Aesthetic Lab — Касса</h1>
					<p class="text-base-content/60">Войдите, чтобы продолжить</p>
				</div>
			</div>
			@LoginFormView(f)
		</div>
		if f.ClearDrafts {
			<script type="module" src="/static/draft.js" data-drafts-clear></script>
		}
	}
}

// LoginFormView is the form alone, for Datastar to patch on an error.
templ LoginFormView(f LoginForm) {
	<form
		id="login-form"
		method="post"
		action="/login"
		class="card bg-base-100 shadow-sm"
		data-signals="{ _busy: false }"
		data-indicator="_busy"
		data-on:submit={ sendForm("/login") }
	>
		<div class="card-body gap-2">
			@Alert(f.Error, "")
			@Field("Имя пользователя", "") {
				<input
					type="text"
					name="username"
					value={ f.Username }
					class="input input-lg w-full text-base"
					autocomplete="username"
					autocapitalize="none"
					autocorrect="off"
					spellcheck="false"
					enterkeyhint="next"
					required
					if f.Username == "" {
						autofocus
					}
				/>
			}
			@Field("Пароль", "") {
				<input
					type="password"
					name="password"
					class="input input-lg w-full text-base"
					autocomplete="current-password"
					enterkeyhint="go"
					required
					if f.Username != "" {
						autofocus
					}
				/>
			}
			<div class="pt-4">
				@SubmitButton("Войти")
			</div>
		</div>
	</form>
}
