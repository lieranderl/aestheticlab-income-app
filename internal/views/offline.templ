package views

// OfflinePage is shown by the service worker when the device is offline.
templ OfflinePage() {
	@Layout("Нет соединения", Nav{}) {
		<div class="mx-auto flex min-h-[70dvh] max-w-sm flex-col items-center justify-center gap-6 text-center py-10">
			<div class="rounded-full bg-base-300/60 p-4 text-base-content/70">
				@Icon("wifi-off", "size-10")
			</div>
			<div class="flex flex-col gap-2">
				<h1 class="text-2xl font-bold">Нет соединения</h1>
				<p class="text-sm text-base-content/70">
					Проверьте подключение к интернету. Если вы заполняли отчёт, ваши данные сохранены на телефоне.
				</p>
			</div>
			<a
				href="/"
				class="btn btn-primary btn-lg w-full max-w-xs"
				data-on:click__prevent="window.location.reload()"
			>
				@Icon("rotate-cw", "size-5")
				Повторить
			</a>
		</div>
	}
}
