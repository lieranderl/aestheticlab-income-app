package views

type SettlementWarning struct{ Text, Href string }
type SettlementPerson struct {
	Name, Balance, Current, Earned, Action, ActionURL, CarryURL string
	Sign, CurrentSign                                           int
	Breakdown                                                   []MoneyRow
}
type SettlementData struct {
	Key, Month, Prev, Next, Notice, AsOf string // AsOf: today, for the current balance
	MonthEnd                             string // the month's last day, or today while it runs
	ShowCurrent                          bool   // today's balance belongs here: the running or a closed month, every finished month closed
	PrevLabel                            string // «Ноябрь 2026», for the «close the previous month» link
	Closed, Running                      bool   // Running: the month has not ended yet
	Figures, Expenses                    []MoneyRow
	People                               []SettlementPerson
	Blockers                             []string
	KassaLink                            bool // movements wait for confirmation
	Warnings, Missing                    []SettlementWarning
	MissingSummary                       string // «Lera — 12 дн. · Zara — 15 дн.»
	MissingUnavailable                   bool   // a calendar could not be read
	MissingByCalendar                    bool   // only days with a customer in the calendar count
	Action                               MonthActionData
	MovementForm                         MovementFormData
}

templ MonthTabs(key string, settlement bool) {
	<nav class="tabs tabs-box w-full flex-nowrap" aria-label="Раздел месяца">
		<a
			class={ "tab min-h-11 flex-1",templ.KV("tab-active",!settlement) }
			href={ templ.SafeURL("/admin/month?m=" + key) }
			if !settlement {
				aria-current="page"
			}
		>Выручка</a>
		<a
			class={ "tab min-h-11 flex-1",templ.KV("tab-active",settlement) }
			href={ templ.SafeURL("/admin/month?m=" + key + "&tab=settlement") }
			if settlement {
				aria-current="page"
			}
		>Итоги и расчёт</a>
	</nav>
}

templ SettlementPage(nav Nav, p SettlementData) {
	@Layout("Итоги и расчёт", nav) {
		@PageHeader("Месяц", "")
		<div class="flex flex-col gap-4">
			@MonthSwitcher(p.Month, p.Prev, p.Next)
			@MonthTabs(p.Key, true)
			@Alert("", p.Notice)
			if p.Closed {
				<p class="alert alert-soft" role="status">Месяц закрыт. Итоги и условия зафиксированы.</p>
			} else {
				// One visible sentence; the why is folded (third production review).
				<div class="alert alert-info alert-soft flex flex-col items-start gap-1" role="status">
					<p>
						Предварительный расчёт. Зарплаты, доплата «Себе» и дивиденды ещё не начислены.
						if p.Running {
							Закрыть месяц можно после его окончания.
						} else {
							Проверьте итоги и закройте месяц.
						}
					</p>
					if p.Running {
						<details>
							<summary class="min-h-11 cursor-pointer py-2 font-medium">Почему прибыль ниже</summary>
							<p>До конца месяца прибыль ниже итоговой: зарплаты учтены за весь месяц, а доход — только за прошедшие дни.</p>
						</details>
					}
				</div>
				// A finished month's main task is closing it: first, not under the people.
				if p.Action.Action!="" {
					@MonthActionSheet(p.Action)
				}
			}
			@adminFigures(p.Figures)
			@breakdown("Расходы по категориям", p.Expenses)
			for _,b:=range p.Blockers {
				<p class="alert alert-error alert-soft" role="alert">
					{ b }
				</p>
				if b == "Сначала закройте предыдущий месяц" && p.Prev != "" {
					<a class="btn min-h-11" href={ templ.SafeURL(p.Prev) }>Открыть: { p.PrevLabel }</a>
				}
			}
			if p.KassaLink {
				<a class="btn min-h-11" href="/admin/kassa">Открыть кассу</a>
			}
			if p.MissingUnavailable {
				<p class="alert alert-soft" role="status">Календарь недоступен — пропущенные отчёты не проверены.</p>
			}
			if len(p.Missing)>0 {
				<details class="collapse collapse-arrow bg-base-100">
					<summary class="collapse-title min-h-14">
						Не сдали отчёт: { p.MissingSummary }
					</summary>
					<div class="collapse-content flex flex-col gap-2">
						if p.MissingByCalendar {
							<p class="text-sm text-base-content/70">Дни, когда в календаре был клиент, а записи в кассе нет.</p>
						} else {
							<p class="text-sm text-base-content/70">Дни без записей клиентов. Если это выходные, ничего делать не нужно.</p>
						}
						for _,warning:=range p.Missing {
							<a
								class="btn btn-ghost min-h-11 h-auto min-w-0 max-w-full justify-start py-3 text-left whitespace-normal [overflow-wrap:anywhere]"
								href={ templ.SafeURL(warning.Href) }
							>{ warning.Text }</a>
						}
					</div>
				</details>
			}
			for _,warning:=range p.Warnings {
				<a
					class="alert alert-warning alert-soft min-h-11"
					href={ templ.SafeURL(warning.Href) }
				>{ warning.Text } · Пересчитать</a>
			}
			for _,c:=range p.People {
				<article class="card bg-base-100 shadow-sm">
					<div class="card-body p-4 gap-3">
						<h2 class="font-semibold break-words">{ c.Name }</h2>
						// The running month leads with today's balance and its action; a
						// finished month leads with its own result, as of its last day.
						if p.Running {
							if p.ShowCurrent {
								@settlementCurrent(p, c, "Текущий остаток")
							}
							@settlementResult(p, c)
						} else {
							@settlementResult(p, c)
							if p.ShowCurrent {
								<section class="flex flex-col gap-3 border-t border-base-200 pt-3">
									@settlementCurrent(p, c, "Остаток сегодня")
								</section>
							}
						}
					</div>
				</article>
			}
			@MovementSheet(p.MovementForm)
			if p.Closed && p.Action.Action!="" {
				@MonthActionSheet(p.Action)
			}
		</div>
	}
}

templ settlementCurrent(p SettlementData, c SettlementPerson, title string) {
	<h3 class="font-semibold">{ title }</h3>
	<p class={ "text-xl font-semibold break-words", templ.KV("text-success", c.CurrentSign > 0), templ.KV("text-error", c.CurrentSign < 0) }>{ c.Current }</p>
	<p class="text-sm text-base-content/60">На { p.AsOf }</p>
	if c.ActionURL!="" {
		<a
			class="btn btn-primary min-h-11"
			href={ templ.SafeURL(c.ActionURL) }
			data-url={ c.ActionURL }
			data-on:click__prevent={ loadMovementForm(true) }
			data-on:datastar-fetch__window={ onMovementLoad }
			data-attr:aria-disabled="$_movementloading"
			data-attr:tabindex="$_movementloading ? -1 : 0"
		>{ c.Action }</a>
	}
	<a
		class="btn btn-ghost min-h-11"
		href={ templ.SafeURL(c.CarryURL) }
	>Перенести</a>
}

templ settlementResult(p SettlementData, c SettlementPerson) {
	<section class="rounded-box bg-base-200 p-4">
		<h3 class="font-semibold">
			if p.Closed {
				Зафиксированный итог месяца
			} else {
				Предварительный итог месяца
			}
		</h3>
		<p class={ "mt-2 break-words", templ.KV("text-xl font-semibold", !p.Running) }>{ c.Balance }</p>
		if !p.Running {
			<p class="text-sm text-base-content/60">На { p.MonthEnd }</p>
		}
		<p class="mt-2 text-sm">Всего заработано: { c.Earned }</p>
		<p class="mt-2 text-sm text-base-content/70">
			if p.Closed {
				Последующие выплаты и внесения отражены в остатке на сегодня.
			} else {
				С учётом ожидаемых начислений при закрытии месяца.
			}
		</p>
		<details class="collapse collapse-arrow">
			<summary class="collapse-title min-h-14">Из чего складывается итог месяца</summary>
			<div class="collapse-content">@moneyRows(c.Breakdown)
</div>
		</details>
	</section>
}
