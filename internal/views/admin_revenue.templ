package views

type MoneyRow struct{ Name, Value string }
type AdminReport struct {
	Client                      bool
	Name, Day, Href, Total      string
	Status                      string // «Салон должен €113,50»
	Tone                        int    // +1 the salon owes the person, −1 the person owes the salon
	Fact, Expected              string // «Факт: в кассу …», «Ожидается: «Себе» …»
	CashToKassa, TransferToCard string
	Details                     []MoneyRow
}
type DayPerson struct {
	Name    string
	Money   MoneyView
	Details []MoneyRow
}
type AdminDay struct {
	Money   MoneyView
	People  []DayPerson
	Date    ReportForm
	Figures []MoneyRow
	Reports []AdminReport
	Missing []string
	Notice  string
}

templ AdminDayPage(nav Nav, p AdminDay) {
	@Layout("День", nav) {
		@PageHeader("День", "")
		if p.Notice != "" {
			<div class="mb-3">
				@Alert("", p.Notice)
			</div>
		}
		@DateSwitcher(p.Date)
		if p.Date.Locked != "" {
			<div role="status" class="alert alert-soft">{ p.Date.Locked }</div>
		}
		<div class="flex flex-col gap-4">
			@MoneyPanel(p.Money)
			@RevenueDetails(p.Figures, "день")
			if len(p.Missing) > 0 {
				<section class="card bg-base-100 shadow-sm">
					<div class="card-body gap-2 p-4">
						<h2 class="font-semibold">Не сдали отчёт</h2>
						<ul class="flex flex-wrap gap-2">
							for _, name := range p.Missing {
								<li class="badge badge-soft badge-warning h-auto min-h-6 max-w-full [overflow-wrap:anywhere]">
									{ name }
								</li>
							}
						</ul>
					</div>
				</section>
			}
			if len(p.Reports) == 0 {
				<p class="rounded-box bg-base-100 p-4 text-base-content/60">Отчётов за этот день нет.</p>
			}
			if len(p.People) > 0 {
				<h2 class="text-lg font-semibold">По сотрудникам</h2>
				<div class="grid gap-3 lg:grid-cols-2">
					for _,person := range p.People {
						@PersonMoneyCard(person.Name, person.Money, person.Details, "день")
					}
				</div>
			}
			<h2 class="text-lg font-semibold">Записи за день</h2>
			@adminReports(p.Reports)
		</div>
	}
}

templ adminFigures(rows []MoneyRow) {
	<section class="grid grid-cols-2 gap-3" aria-label="Итоги">
		for _, row := range rows {
			@figure(row.Name, row.Value)
		}
	</section>
}

templ RevenueDetails(rows []MoneyRow, period string) {
	if details := revenueDetailRows(rows); len(details) > 0 {
		<details class="collapse collapse-arrow bg-base-100 shadow-sm">
			<summary class="collapse-title min-h-14 font-semibold">Услуги и продажи</summary>
			<div class="collapse-content">@moneyRows(details)</div>
		</details>
	}
	if certificates := namedMoneyRows(rows, "Продажа сертификатов", "Оплачено сертификатами"); len(certificates) > 0 {
		<details class="collapse collapse-arrow bg-base-100 shadow-sm">
			<summary class="collapse-title min-h-14 font-semibold">Сертификаты</summary>
			<div class="collapse-content">@moneyRows(certificates)</div>
		</details>
	}
	if counts := namedMoneyRows(rows, "Клиенты", "Рабочие дни"); len(counts) > 0 {
		<div class="px-1 text-sm">@moneyRows(counts)</div>
	}
}

func namedMoneyRows(rows []MoneyRow, names ...string) []MoneyRow {
	var out []MoneyRow
	for _, name := range names {
		for _, row := range rows {
			if row.Name == name {
				out = append(out, row)
				break
			}
		}
	}
	return out
}

func revenueDetailRows(rows []MoneyRow) []MoneyRow {
	var out []MoneyRow
	for _, row := range rows {
		switch row.Name {
		case "Выручка", "«Себе»", "«Салону»", "Клиенты", "Продажа сертификатов", "Оплачено сертификатами", "Рабочие дни", "Касса — наличные", "Касса — карта салона":
			continue
		}
		if row.Name == "Услуги" || row.Value != "€0" {
			out = append(out, row)
		}
	}
	return out
}

templ moneyRows(rows []MoneyRow) {
	<dl class="flex flex-col gap-2">
		for _, row := range rows {
			<div class="flex justify-between gap-3">
				<dt class="min-w-0 [overflow-wrap:anywhere] text-base-content/70">
					{ row.Name }
				</dt>
				<dd class="shrink-0 font-medium">
					{ row.Value }
				</dd>
			</div>
		}
	</dl>
}

templ adminReports(rows []AdminReport) {
	<div class="flex flex-col gap-3">
		for _, r := range rows {
			<details class="collapse collapse-arrow bg-base-100 shadow-sm">
				<summary class="collapse-title min-h-14">
					<span class="block min-w-0 font-semibold [overflow-wrap:anywhere]">
						{ r.Name } · { r.Day }
					</span>
					<span class="text-lg font-semibold">
						{ r.Total }
					</span>
					<span class="my-1 block">
						@statusChip(r.Status, r.Tone)
					</span>
					<span class="block text-sm">
						{ r.Fact }
					</span>
					<span class="block text-sm text-base-content/70">
						{ r.Expected }
					</span>
				</summary>
				<div class="collapse-content flex flex-col gap-3">
					@moneyRows(r.Details)
					if !r.Client {
						@moneyRows([]MoneyRow{{Name: "Наличными в кассу", Value: r.CashToKassa}, {Name: "Переводом на карту салона", Value: r.TransferToCard}})
					}
					<a href={ templ.SafeURL(r.Href) } class="btn min-h-11">
						@Icon("pencil", "size-4")
						Изменить
					</a>
				</div>
			</details>
		}
	</div>
}

type MonthPerson struct {
	Name, Days, Clients string
	Money               MoneyView
	Details             []MoneyRow
}
type AdminMonth struct {
	Money                              MoneyView
	Key, Month, Prev, Next, RecordsURL string
	Figures, Categories, Payments []MoneyRow
	People                        []MonthPerson
	Closed                        bool
}

templ AdminMonthPage(nav Nav, p AdminMonth) {
	@Layout("Месяц", nav) {
		@PageHeader("Месяц", "")
		<div class="flex flex-col gap-4">
			@MonthSwitcher(p.Month, p.Prev, p.Next)
			@MonthTabs(p.Key, false)
			<h2 class="text-lg font-semibold">Выручка</h2>
			if p.Closed {
				<div role="status" class="alert alert-soft">Месяц закрыт — изменения недоступны</div>
			}
			@MoneyPanel(p.Money)
			@RevenueDetails(p.Figures, "месяц")
			if len(p.Payments)>0 {
				@breakdown("По способам оплаты · Отчёты за день", p.Payments)
			}
			<section class="flex flex-col gap-3">
				<h2 class="text-lg font-semibold">По сотрудникам</h2>
				if len(p.People) == 0 {
					<p class="rounded-box bg-base-100 p-4 text-base-content/60">Отчётов за этот месяц нет.</p>
				}
				<div class="grid gap-3 lg:grid-cols-2">
					for _, person := range p.People {
						@PersonMoneyCard(person.Name, person.Money, monthPersonRows(person), "месяц")
					}
				</div>
			</section>
			<a class="btn min-h-11" href={ templ.SafeURL(p.RecordsURL) }>Открыть записи за месяц</a>
		</div>
	}
}

templ breakdown(title string, rows []MoneyRow) {
	<section class="card min-w-0 bg-base-100 shadow-sm">
		<div class="card-body min-w-0 gap-3 p-4">
			<h2 class="min-w-0 font-semibold [overflow-wrap:anywhere]">{ title }</h2>
			if len(rows) == 0 {
				<p class="text-base-content/60">Записей нет.</p>
			}
			@moneyRows(rows)
		</div>
	</section>
}

func monthPersonRows(person MonthPerson) []MoneyRow {
	rows := append([]MoneyRow{{Name: "Рабочие дни", Value: person.Days}}, person.Details...)
	if person.Clients != "" {
		rows = append(rows, MoneyRow{Name: "Клиенты", Value: person.Clients})
	}
	return rows
}
