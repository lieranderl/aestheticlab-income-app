{
  "displayName": "Kassa production readyz failing",
  "combiner": "OR",
  "conditions": [{
    "displayName": "Kassa production readyz fails from 2+ regions",
    "conditionThreshold": {
      "filter": "metric.type = \"monitoring.googleapis.com/uptime_check/check_passed\" AND resource.type = \"uptime_url\" AND metric.labels.check_id = \"${CHECK_ID}\"",
      "aggregations": [{"alignmentPeriod": "1200s", "perSeriesAligner": "ALIGN_NEXT_OLDER", "crossSeriesReducer": "REDUCE_COUNT_FALSE", "groupByFields": ["resource.labels.host"]}],
      "comparison": "COMPARISON_GT", "thresholdValue": 1, "duration": "60s", "trigger": {"count": 1}
    }
  }],
  "alertStrategy": {"autoClose": "604800s"},
  "documentation": {"content": "https://${APP_HOST}/readyz is failing. Check the service: gcloud run services describe aestheticlab-income --project <project> --region europe-west1, and its logs.", "mimeType": "text/markdown"},
  "userLabels": {"app": "kassa"},
  "notificationChannels": ["projects/${PROJECT}/notificationChannels/${CHANNEL_ID}"]
}
